# ─── LLM ────────────────────────────────────────────────────
# Provider: ollama (local) or anthropic
LLM=ollama
# Model to use. For ollama it must already be pulled (see `ollama list`).
MODEL=qwen3:8b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_PORT=11434
# Context window for ollama models. Bigger = more code fits, more RAM/VRAM used.
# NUM_CTX=16384
# Force thinking/reasoning on or off for models that support it.
# Unset = model default. qwen3 needs thinking to plan tool use reliably;
# THINK=false makes it faster but it may narrate instead of acting.
# THINK=true
# Only needed when LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Workspace ──────────────────────────────────────────────
# The directory the coding agent reads, edits, and runs commands in.
# Defaults to the directory the server is started from.
# AGENT_WORKSPACE=/path/to/your/project

# ─── Memory ─────────────────────────────────────────────────
# Remember earlier messages in the session (recommended for chat).
USE_MEMORY=true
# Token budget for short term memory.
# MEMORY_BUDGET=8192

# ─── Server ─────────────────────────────────────────────────
# PORT=3001
# Override the built-in coding system prompt.
# SYSTEM_PROMPT=
